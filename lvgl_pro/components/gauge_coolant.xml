<component>
    <view width="352" height="352" align="center" style_radius="176" style_bg_color="0x111822" style_bg_opa="100%" style_border_color="0x263547" style_border_width="3" style_pad_all="0">
        <!-- 270° Temperature Arc (100.0°F to 260.0°F) with Dynamic Color Coding -->
        <lv_arc width="306" height="306" align="center"
                rotation="135"
                bg_start_angle="0" bg_end_angle="270"
                min_value="1000" max_value="2600"
                value="{subject_coolant_temp_tenths}"
                style_arc_width="18" style_arc_color="0x1e293b"
                style_arc_width-indicator="18"
                style_arc_color-indicator="{subject_coolant_temp_tenths GE 2250 ? 0xef4444 : (subject_coolant_temp_tenths GE 2050 ? 0xf59e0b : 0x10b981)}"
                style_bg_opa-knob="0"/>

        <!-- Center Digital Temperature Readout -->
        <lv_label text="{subject_coolant_temp_tenths / 10 . ' °F'}" align="center" y="-10" style_text_color="0xf1f5f9"/>

        <!-- Center Subtitle Label -->
        <lv_label text="COOLANT TEMP" align="center" y="24" style_text_color="0x64748b"/>
    </view>
</component>
