<component>
    <view width="352" height="352" align="center" style_radius="176" style_bg_color="0x111822" style_bg_opa="100%" style_border_color="0x263547" style_border_width="3" style_pad_all="0">
        <!-- Header -->
        <lv_label text="Table switching" align="top_mid" y="38" style_text_color="0xcbd5e1"/>

        <!-- Fuel VE Table Card -->
        <lv_obj width="278" height="68" align="center" y="-38" style_radius="14" style_bg_color="0x182230" style_bg_opa="100%" style_border_color="0x2b3b4e" style_border_width="1" style_pad_hor="14">
            <lv_label text="Fuel VE Table" align="top_left" x="0" y="8" style_text_color="0xf1f5f9"/>

            <!-- Badge 1 (Active when switch is OFF) -->
            <lv_obj width="26" height="22" align="bottom_left" x="0" y="-6" style_radius="6" style_border_width="0" style_pad_all="0"
                    style_bg_color="{subject_fuel_table_2 == 0 ? 0x0ea5e9 : 0x1e293b}">
                <lv_label text="1" align="center" style_text_color="{subject_fuel_table_2 == 0 ? 0xffffff : 0x475569}"/>
            </lv_obj>

            <!-- Badge 2 (Active when switch is ON) -->
            <lv_obj width="26" height="22" align="bottom_left" x="32" y="-6" style_radius="6" style_border_width="0" style_pad_all="0"
                    style_bg_color="{subject_fuel_table_2 == 1 ? 0xf59e0b : 0x1e293b}">
                <lv_label text="2" align="center" style_text_color="{subject_fuel_table_2 == 1 ? 0x0f172a : 0x475569}"/>
            </lv_obj>

            <!-- Toggle Switch -->
            <lv_switch bind_checked="subject_fuel_table_2" width="52" height="28" align="right_mid" x="0"
                       style_bg_color="0x334155" style_bg_color-indicator-checked="0xf59e0b"/>
        </lv_obj>

        <!-- Ignition Table Card -->
        <lv_obj width="278" height="68" align="center" y="46" style_radius="14" style_bg_color="0x182230" style_bg_opa="100%" style_border_color="0x2b3b4e" style_border_width="1" style_pad_hor="14">
            <lv_label text="Ignition Table" align="top_left" x="0" y="8" style_text_color="0xf1f5f9"/>

            <!-- Badge 1 (Active when switch is OFF) -->
            <lv_obj width="26" height="22" align="bottom_left" x="0" y="-6" style_radius="6" style_border_width="0" style_pad_all="0"
                    style_bg_color="{subject_ign_table_2 == 0 ? 0x0ea5e9 : 0x1e293b}">
                <lv_label text="1" align="center" style_text_color="{subject_ign_table_2 == 0 ? 0xffffff : 0x475569}"/>
            </lv_obj>

            <!-- Badge 2 (Active when switch is ON) -->
            <lv_obj width="26" height="22" align="bottom_left" x="32" y="-6" style_radius="6" style_border_width="0" style_pad_all="0"
                    style_bg_color="{subject_ign_table_2 == 1 ? 0xf59e0b : 0x1e293b}">
                <lv_label text="2" align="center" style_text_color="{subject_ign_table_2 == 1 ? 0x0f172a : 0x475569}"/>
            </lv_obj>

            <!-- Toggle Switch -->
            <lv_switch bind_checked="subject_ign_table_2" width="52" height="28" align="right_mid" x="0"
                       style_bg_color="0x334155" style_bg_color-indicator-checked="0xf59e0b"/>
        </lv_obj>
    </view>
</component>
