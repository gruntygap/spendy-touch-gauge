<component>
    <view width="82" height="16" align="top_mid" y="12" style_bg_opa="0" style_border_width="0" style_pad_all="0"
          style_opa="{subject_dots_visible == 1 ? 255 : 0}">
        <!-- 5 Top Page Indicator Dots (7x7 Circle Pills) -->
        <lv_obj width="7" height="7" align="center" x="-28" style_radius="4" style_border_width="0"
                style_bg_color="{subject_active_tile == 0 ? 0x38bdf8 : 0x334155}"/>

        <lv_obj width="7" height="7" align="center" x="-14" style_radius="4" style_border_width="0"
                style_bg_color="{subject_active_tile == 1 ? 0x38bdf8 : 0x334155}"/>

        <lv_obj width="7" height="7" align="center" x="0" style_radius="4" style_border_width="0"
                style_bg_color="{subject_active_tile == 2 ? 0x38bdf8 : 0x334155}"/>

        <lv_obj width="7" height="7" align="center" x="14" style_radius="4" style_border_width="0"
                style_bg_color="{subject_active_tile == 3 ? 0x38bdf8 : 0x334155}"/>

        <lv_obj width="7" height="7" align="center" x="28" style_radius="4" style_border_width="0"
                style_bg_color="{subject_active_tile == 4 ? 0x38bdf8 : 0x334155}"/>
    </view>
</component>
